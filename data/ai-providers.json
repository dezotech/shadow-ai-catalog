      "aliases": ["chat.openai.com", "api.openai.com"],
      "tiers": { "api.openai.com": "enterprise" },
      "category": "Generative AI - Assistant",
      "riskTier": "high",
      "compliance": {
        "consumer": { "baaAvailable": false, "trainsOnInput": true, "dataRetention": "Until deleted by user; deleted chats and Temporary Chats purged within 30 days (legal/security holds excepted) / Apr-Sep 2025 consumer data under NYT-litigation legal hold (indefinite-retention order ended 2025-09-26)" },
        "enterprise": { "baaAvailable": true, "trainsOnInput": false, "dataRetention": "API: abuse-monitoring logs up to 30 days by default, with legal and safety exceptions; application-state retention varies by endpoint. Approved ZDR controls have endpoint and feature limitations." }
      },
      "dualPurpose": false,
      "jurisdiction": "US",
      "frameworkFlags": ["pii-risk"],
      "sources": [
        "https://developers.openai.com/api/reference/overview",
        "https://openai.com/enterprise-privacy/",
        "https://help.openai.com/en/articles/8660679-how-can-i-get-a-business-associate-agreement-baa-with-openai",
